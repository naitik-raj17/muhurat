# Copy to .env and adjust. Every value below has a working dev default, so the app runs
# with no .env at all. With APP_ENV=production the app refuses to start on dev secrets.
# Real external providers switch on ONLY when their keys below are set; otherwise mocks run.

# ---------------------------------------------------------------- core
# dev | test | production
APP_ENV=dev
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- database / cache
# Inside docker compose the host is "postgres"/"redis" (compose sets this); from your machine use localhost.
DATABASE_URL=postgresql+asyncpg://wedding:wedding@localhost:5432/wedding
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- auth
# HS256 signing secret for JWT access tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
JWT_EXPIRES_MINUTES=480
# Requests per minute per user (or per IP when unauthenticated).
RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------- PII protection (DPDP Act 2023)
# Fernet key used to encrypt guest/user phone + email at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=OgletkQ1VqIM0qMckEAS5U-inbQvCGA1EZS54BOEFnA=
# HMAC key for the searchable hash of phone/email (dedupe + webhook lookup).
PII_HASH_KEY=dev-only-hash-key-change-me

# ---------------------------------------------------------------- object storage (MinIO / S3)
# minio | memory (memory is used by unit tests)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wedding-files
MINIO_SECURE=false

# ---------------------------------------------------------------- LLM (mock unless key set)
# OpenRouter (OpenAI-compatible). Model IDs live in config/models.yaml, never here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- embeddings + vector store
# sentence_transformers = real multilingual model (downloads ~470 MB on first use)
# hash = deterministic offline embedder used in tests/CI
EMBEDDING_PROVIDER=sentence_transformers
# pgvector is the default. Pinecone switches on only when PINECONE_API_KEY is set.
PINECONE_API_KEY=
PINECONE_INDEX=wedding-vendors

# ---------------------------------------------------------------- messaging (mock unless keys set)
# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Secret used to verify X-Hub-Signature-256 on incoming WhatsApp webhooks.
WHATSAPP_APP_SECRET=
# Email via Gmail SMTP with an app password (Gmail API OAuth is a later option).
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Any string; Meta echoes it during the webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=
# Signing secret for the mock provider's webhooks (simulated guest replies).
MOCK_WEBHOOK_SECRET=dev-only-mock-webhook-secret

# ---------------------------------------------------------------- calendar / payments (mock unless set)
GOOGLE_CALENDAR_CREDENTIALS_FILE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------- jobs + workflows
# The ONE job system in use. inprocess = FastAPI background tasks + in-process outbox worker
# (no extra services). temporal = Temporal runs the outbox drain, reminders and one long-lived
# workflow per wedding (docker compose sets this; needs the temporal + worker services).
JOB_BACKEND=inprocess
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=wedding-workflows
# How often each wedding's workflow runs the agents (signals run them sooner).
WEDDING_WORKFLOW_INTERVAL_MINUTES=360
# Prometheus metrics of the Temporal worker process (the API serves its own at /metrics).
WORKER_METRICS_PORT=9100

# ---------------------------------------------------------------- outbox
# JOB_BACKEND=inprocess: the API process runs the outbox dispatcher (polls every N seconds).
# JOB_BACKEND=temporal: the drain workflow uses the same poll interval.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=2

# ---------------------------------------------------------------- observability
# Sentry is disabled when empty.
SENTRY_DSN=
